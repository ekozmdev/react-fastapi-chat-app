# Application Settings
# APP_TITLE=LLM Chat API

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database Settings (Individual Components) - Recommended for production
# これらの設定からDATABASE_URLが自動構築されます
# 未設定時はデフォルト値が使用されますが、本番環境では設定を推奨します
# Docker Compose使用時: DB_HOSTは自動で"postgres"に設定されます

# Database Protocol (default: postgresql+psycopg)
DB_PROTOCOL=postgresql+psycopg

# Database Host (default: localhost)
DB_HOST=localhost

# Database Port (default: 5432)
DB_PORT=5432

# Database User (default: chatuser)
DB_USER=chatuser

# Database Password (default: chatpassword) - 本番環境では必ず変更してください
DB_PASSWORD=chatpassword

# Database Name (default: chatdb)
DB_NAME=chatdb

# Optional: Redis URL (for session management)
# REDIS_URL=redis://localhost:6379

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:80
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE

# Optional: OpenAI Model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o
# 利用可能なモデル: gpt-4o, gpt-4o-mini, gpt-3.5-turbo

# Optional: OpenAI Max Tokens (default: 1024)
# OPENAI_MAX_TOKENS=1024

# Optional: OpenAI Temperature (default: 0.7)
# Range: 0.0-2.0, Lower = more deterministic, Higher = more creative
# OPENAI_TEMPERATURE=0.7

# JWT認証設定（必須）
# 512bit以上の強力な秘密鍵を設定
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your_jwt_secret_key_here_please_generate_secure_key

# Optional: JWT Token Expiration (default: 1440 minutes = 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440