# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database URL
# Docker Compose使用時は docker-compose.ymlで設定されるため不要
# ローカル開発時は以下を使用
DATABASE_URL=postgresql://chatuser:chatpassword@localhost:5432/chatdb

# Optional: Redis URL (for session management)
# REDIS_URL=redis://localhost:6379

# Optional: CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Optional: OpenAI Model (default: gpt-4.1)
# OPENAI_MODEL=gpt-4.1
# 利用可能なモデル: gpt-4.1, gpt-4.1-mini, gpt-4.1-nano